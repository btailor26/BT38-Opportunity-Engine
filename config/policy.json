      "positive_requirements": [
        "post or discussion is recent",
        "speaker is experiencing the problem, represents the business, or is explicitly buying on its behalf",
        "problem/request is current rather than hypothetical",
        "ecommerce, marketplace, inventory, warehouse, 3PL, fulfilment or related operational context is present"
      ],
      "provider_side_suppression": [
        "we offer",
        "our services",
        "book a call",
        "contact us for fulfilment",
        "contact us for fulfillment",
        "we help brands",
        "we help ecommerce",
        "our 3PL",
        "our agency",
        "our consultancy",
        "looking for clients",
        "accepting new clients",
        "we provide",
        "we specialise in",
        "we specialize in"
      ],
      "ranking": [
        "explicit current request for a consultant/expert/help",
        "current operational failure with measurable business impact",
        "request for recommendation from an owner/operator",
        "replacement/change of 3PL, warehouse, WMS, ERP or operational system",
        "outgrown current process or excessive manual work",
        "multichannel expansion causing a current operational gap"
      ],
      "freshness_rule": "Live-opportunity search window is up to 30 days old. Reject results older than 30 days from the live lead feed. Prefer newer evidence when multiple results exist. Historical posts older than 30 days may only be used to improve search patterns and must never be presented as current opportunities.",
      "qualification_boundary": "A matching conversation is DISCOVERED only. It cannot become CONTACT_READY until company identity, current need, ability to pay, decision-maker and usable contact route are independently verified.",
      "max_live_age_days": 30
    },
    "search_method": "Combine buyer-conversation patterns with commerce_context and search_surfaces. Prefer first-person posts/discussions from the buyer side. Suppress provider/service pages and generic job-board noise unless the listing exposes a credible consultancy/contract buying requirement."
  },
  "opportunity_routes": {
    "direct_client": {
      "description": "Ecommerce business with a current operational trigger or explicit request for help that could justify an independent audit or operational support."
    },
    "live_paid_support": {
      "description": "Company, founder or buyer currently seeking consultant, contractor, agency, freelancer or specialist help across ecommerce operations or marketplaces.",
      "qualification_rule": "Must show a current requirement. Future/hypothetical networking or possible overflow is insufficient."
    }
  },
  "target_profile": {
    "geography": "UK preferred",
    "business": "ecommerce/DTC physical consumer products or businesses operating on relevant ecommerce marketplaces",
    "signals": [
      "own website",
      "active marketplace selling",
      "meaningful inventory",
      "warehouse or 3PL",
      "operational change or pressure",
      "explicit current request for help"
    ],
    "coverage": [
      "product",
      "sourcing/buying",
      "listing",
      "marketplaces",
      "website",
      "inventory",
      "warehouse/3PL",
      "orders",
      "payments",
      "fulfilment",
      "shipping/tracking",
      "returns",
      "reconciliation",
      "costs/margins",
      "reporting",
      "workflow optimisation",
      "operational systems",
      "marketplace integrations",
      "stock synchronization"
    ]
  },
  "reject_if": [
    "duplicate opportunity/evidence",
    "anonymous company with no resolvable buyer",
    "generic free-advice request",
    "generic networking with no current buying requirement",
    "3PL placement only with no separate operational/audit need",
    "no current reason to engage"
  ],
  "statuses": [
    "DISCOVERED",
    "RESEARCHED",
    "QUALIFIED",
    "CONTACT_READY",
    "CONTACTED",
    "FOLLOW_UP",
    "CONVERSATION",
