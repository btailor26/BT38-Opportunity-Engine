{
  "engine": "BT38 Opportunity Engine",
  "version": 5,
  "contact_ready_requires_all_gates": true,
  "auto_contact": false,
  "gates": [
    "company_fit",
    "current_trigger",
    "ability_to_pay",
    "decision_maker_contact"
  ],
  "discovery": {
    "buyer_intent_terms": [
      "looking for a consultant",
      "looking for an ecommerce consultant",
      "looking for an e-commerce consultant",
      "need a consultant",
      "need help with",
      "looking for someone to help",
      "seeking ecommerce consultant",
      "seeking e-commerce consultant",
      "need support",
      "looking for an agency",
      "looking for a contractor",
      "need a contractor",
      "looking for a freelancer",
      "need someone experienced",
      "operations support needed",
      "inventory problems",
      "stock problems",
      "fulfilment problems",
      "fulfillment problems",
      "3PL issues",
      "warehouse issues",
      "multichannel problems",
      "marketplace problems",
      "need help scaling",
      "need operational support"
    ],
    "non_buying_terms": [
      "looking to connect",
      "building my network",
      "open to partnerships",
      "let's collaborate",
      "lets collaborate",
      "networking",
      "connect with specialists"
    ],
    "rule": "Discovery prioritises companies, founders and buyers with a current request for help, consultancy, agency, contractor, freelancer or operational support. Networking/connection language alone is not a buying signal.",
    "marketplace_rule": "Treat marketplace names as discovery context, not proof of buying intent. A prospect still needs a current request/problem/trigger and must pass qualification.",
    "search_surfaces": [
      {
        "name": "LinkedIn",
        "priority": "HIGH",
        "signals": [
          "founder posts",
          "operations posts",
          "hiring posts",
          "requests for recommendations",
          "company updates"
        ]
      },
      {
        "name": "Reddit",
        "priority": "HIGH",
        "signals": [
          "explicit help requests",
          "consultant/contractor requests",
          "seller pain",
          "3PL/fulfilment problems",
          "marketplace problems"
        ]
      },
      {
        "name": "Facebook Groups",
        "priority": "HIGH",
        "signals": [
          "seller groups",
          "ecommerce groups",
          "Amazon/eBay/TikTok/Etsy groups",
          "3PL/fulfilment groups",
          "recommendation requests"
        ]
      },
      {
        "name": "X / Twitter",
        "priority": "MEDIUM",
        "signals": [
          "founder/operator posts",
          "help requests",
          "operational complaints",
          "recommendation requests"
        ]
      },
      {
        "name": "Shopify Community",
        "priority": "HIGH",
        "signals": [
          "inventory",
          "fulfilment",
          "multichannel",
          "operations",
          "integration problems"
        ]
      },
      {
        "name": "Amazon Seller Forums",
        "priority": "HIGH",
        "signals": [
          "FBA/FBM",
          "inventory",
          "VTR/tracking",
          "fulfilment",
          "account operations",
          "multichannel"
        ]
      },
      {
        "name": "eBay Community",
        "priority": "HIGH",
        "signals": [
          "seller operations",
          "inventory",
          "fulfilment",
          "tracking",
          "multichannel"
        ]
      },
      {
        "name": "Etsy Community",
        "priority": "MEDIUM",
        "signals": [
          "seller scaling",
          "inventory",
          "fulfilment",
          "operations"
        ]
      },
      {
        "name": "TikTok Shop seller communities",
        "priority": "HIGH",
        "signals": [
          "seller operations",
          "fulfilment",
          "inventory",
          "integration",
          "multichannel"
        ]
      },
      {
        "name": "Discord / Slack ecommerce communities",
        "priority": "MEDIUM",
        "signals": [
          "live help requests",
          "contractor requests",
          "operator discussions"
        ]
      },
      {
        "name": "Indie Hackers",
        "priority": "MEDIUM",
        "signals": [
          "ecommerce founders",
          "operations problems",
          "scaling",
          "help requests"
        ]
      },
      {
        "name": "3PL / fulfilment industry communities",
        "priority": "HIGH",
        "signals": [
          "client problems",
          "overflow",
          "warehouse transitions",
          "referrals",
          "fulfilment failures"
        ]
      },
      {
        "name": "Job boards and contractor marketplaces",
        "priority": "HIGH",
        "signals": [
          "consultant",
          "contractor",
          "freelancer",
          "interim",
          "project",
          "audit",
          "operations requirement"
        ]
      },
      {
        "name": "Ecommerce trade press / company news",
        "priority": "MEDIUM",
        "signals": [
          "expansion",
          "funding",
          "new channel",
          "warehouse move",
          "3PL change",
          "acquisition",
          "rapid growth"
        ]
      }
    ],
    "commerce_context": [
      "Amazon",
      "Amazon FBA",
      "Amazon FBM",
      "eBay",
      "TikTok Shop",
      "Etsy",
      "Walmart Marketplace",
      "Shopify",
      "WooCommerce",
      "BigCommerce",
      "Magento / Adobe Commerce",
      "Faire",
      "OnBuy",
      "Temu",
      "SHEIN",
      "Wayfair",
      "Zalando",
      "ASOS",
      "Fruugo",
      "Mirakl",
      "Facebook Shops",
      "Instagram Shopping",
      "Google Shopping",
      "multichannel",
      "omnichannel",
      "marketplace"
    ],
    "surface_rule": "Search surfaces are where people talk or expose a current requirement. Commerce platforms are context terms only. Do not treat a retailer or marketplace name as a search surface by itself.",
    "signal_priority": [
      "explicitly asking for help / consultant / contractor / specialist",
      "current operational problem with business impact",
      "warehouse, 3PL, WMS, ERP or fulfilment change",
      "marketplace/channel expansion creating operational complexity",
      "hiring that exposes a current operational gap",
      "funding, acquisition or rapid growth creating operational pressure"
    ],
    "negative_signal_rule": "Connection/networking posts without a current buyer-side need are not opportunities."
  },
  "opportunity_routes": {
    "direct_client": {
      "description": "Ecommerce business with a current operational trigger or explicit request for help that could justify an independent audit or operational support."
    },
    "live_paid_support": {
      "description": "Company, founder or buyer currently seeking consultant, contractor, agency, freelancer or specialist help across ecommerce operations or marketplaces.",
      "qualification_rule": "Must show a current requirement. Future/hypothetical networking or possible overflow is insufficient."
    }
  },
  "target_profile": {
    "geography": "UK preferred",
    "business": "ecommerce/DTC physical consumer products or businesses operating on relevant ecommerce marketplaces",
    "signals": [
      "own website",
      "active marketplace selling",
      "meaningful inventory",
      "warehouse or 3PL",
      "operational change or pressure",
      "explicit current request for help"
    ],
    "coverage": [
      "product",
      "sourcing/buying",
      "listing",
      "marketplaces",
      "website",
      "inventory",
      "warehouse/3PL",
      "orders",
      "payments",
      "fulfilment",
      "shipping/tracking",
      "returns",
      "reconciliation",
      "costs/margins",
      "reporting",
      "workflow optimisation",
      "operational systems",
      "marketplace integrations",
      "stock synchronization"
    ]
  },
  "reject_if": [
    "duplicate opportunity/evidence",
    "anonymous company with no resolvable buyer",
    "generic free-advice request",
    "generic networking with no current buying requirement",
    "3PL placement only with no separate operational/audit need",
    "no current reason to engage"
  ],
  "statuses": [
    "DISCOVERED",
    "RESEARCHED",
    "QUALIFIED",
    "CONTACT_READY",
    "CONTACTED",
    "FOLLOW_UP",
    "CONVERSATION",
    "PROPOSAL",
    "WON",
    "LOST",
    "REJECTED"
  ]
}
