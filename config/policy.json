{
  "engine": "BT38 Opportunity Engine",
  "version": 3,
  "contact_ready_requires_all_gates": true,
  "auto_contact": false,
  "gates": [
    "company_fit",
    "current_trigger",
    "ability_to_pay",
    "decision_maker_contact"
  ],
  "discovery": {
    "buyer_intent_terms": [
      "looking for a consultant",
      "looking for an ecommerce consultant",
      "looking for an e-commerce consultant",
      "need a consultant",
      "need help with",
      "looking for someone to help",
      "seeking ecommerce consultant",
      "seeking e-commerce consultant",
      "need support",
      "looking for an agency",
      "looking for a contractor",
      "need a contractor",
      "looking for a freelancer",
      "need someone experienced",
      "operations support needed",
      "inventory problems",
      "stock problems",
      "fulfilment problems",
      "fulfillment problems",
      "3PL issues",
      "warehouse issues",
      "multichannel problems",
      "marketplace problems",
      "need help scaling",
      "need operational support"
    ],
    "marketplaces": [
      "Amazon",
      "Amazon FBA",
      "Amazon FBM",
      "eBay",
      "TikTok Shop",
      "Etsy",
      "Walmart Marketplace",
      "Walmart",
      "Shopify",
      "WooCommerce",
      "Faire",
      "OnBuy",
      "Temu",
      "SHEIN Marketplace",
      "Wayfair",
      "Zalando",
      "ASOS Marketplace",
      "Fruugo",
      "Mirakl",
      "B&Q Marketplace",
      "The Range Marketplace",
      "Very",
      "Next Marketplace",
      "Facebook Shops",
      "Instagram Shopping",
      "Google Shopping"
    ],
    "non_buying_terms": [
      "looking to connect",
      "building my network",
      "open to partnerships",
      "let's collaborate",
      "lets collaborate",
      "networking",
      "connect with specialists"
    ],
    "rule": "Discovery prioritises companies, founders and buyers with a current request for help, consultancy, agency, contractor, freelancer or operational support. Networking/connection language alone is not a buying signal."
  },
  "opportunity_routes": {
    "direct_client": {
      "description": "Ecommerce business with a current operational trigger or explicit request for help that could justify an independent audit or operational support."
    },
    "live_paid_support": {
      "description": "Company, founder or buyer currently seeking consultant, contractor, agency, freelancer or specialist help across ecommerce operations or marketplaces.",
      "qualification_rule": "Must show a current requirement. Future/hypothetical networking or possible overflow is insufficient."
    }
  },
  "target_profile": {
    "geography": "UK preferred",
    "business": "ecommerce/DTC physical consumer products or businesses operating on relevant ecommerce marketplaces",
    "signals": [
      "own website",
      "active marketplace selling",
      "meaningful inventory",
      "warehouse or 3PL",
      "operational change or pressure",
      "explicit current request for help"
    ],
    "coverage": [
      "product",
      "sourcing/buying",
      "listing",
      "marketplaces",
      "website",
      "inventory",
      "warehouse/3PL",
      "orders",
      "payments",
      "fulfilment",
      "shipping/tracking",
      "returns",
      "reconciliation",
      "costs/margins",
      "reporting",
      "workflow optimisation",
      "operational systems",
      "marketplace integrations",
      "stock synchronization"
    ]
  },
  "reject_if": [
    "duplicate opportunity/evidence",
    "anonymous company with no resolvable buyer",
    "generic free-advice request",
    "generic networking with no current buying requirement",
    "3PL placement only with no separate operational/audit need",
    "no current reason to engage"
  ],
  "statuses": [
    "DISCOVERED",
    "RESEARCHED",
    "QUALIFIED",
    "CONTACT_READY",
    "CONTACTED",
    "FOLLOW_UP",
    "CONVERSATION",
    "PROPOSAL",
    "WON",
    "LOST",
    "REJECTED"
  ]
}
