    "surface_rule": "Search surfaces are where people talk or expose a current requirement. Commerce platforms are context terms only. Do not treat a retailer or marketplace name as a search surface by itself.",
    "signal_priority": [
      "explicitly asking for help / consultant / contractor / specialist",
      "current operational problem with business impact",
      "warehouse, 3PL, WMS, ERP or fulfilment change",
      "marketplace/channel expansion creating operational complexity",
      "hiring that exposes a current operational gap",
      "funding, acquisition or rapid growth creating operational pressure"
    ],
    "negative_signal_rule": "Connection/networking posts without a current buyer-side need are not opportunities.",
    "buyer_conversation_detector": {
      "purpose": "Find recent first-person buyer-side conversations exposing a current ecommerce operational problem or an active request for help. Do not search primarily for service names or providers.",
